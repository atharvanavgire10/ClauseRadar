# ---------------------------------------------------------------------------
# ClauseRadar — environment template
# Copy to .env for local development:  copy .env.example .env  (Windows)
#                                       cp .env.example .env    (macOS/Linux)
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# Database — local default is SQLite; compose/prod uses PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3
# Example PostgreSQL URL:
# DATABASE_URL=postgres://clausradar:clausradar@localhost:5432/clauseradar

# Redis / Celery (optional locally — app falls back to eager execution)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# CORS / frontend origin
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
MAX_UPLOAD_MB=25
MEDIA_ROOT=media

# Public evaluation workspace
PUBLIC_EVAL_ENABLED=True
PUBLIC_EVAL_SLUG=eval

# AI (optional — app works without any key)
AI_PROVIDER=none
# AI_PROVIDER=gemini | openai | none
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# Email (optional — console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ClauseRadar <noreply@clauseradar.local>
# For real delivery, set SMTP below (all read by Django settings):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Production hardening (only applied when DJANGO_DEBUG=False)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
# SECURE_SSL_REDIRECT=False

# Pagination / throttling defaults
API_PAGE_SIZE=25
