# Frontend env template — copy to .env (gitignored) for local overrides.
VITE_API_URL=http://localhost:8000
# Production: absolute API origin (VITE_API_URL=https://api.example.com)
# or the literal "same-origin" for same-origin deployments (VITE_API_URL=same-origin).
# Production builds (npm run build:prod) REQUIRE VITE_API_URL and reject localhost fallbacks.
